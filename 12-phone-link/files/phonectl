#!/usr/bin/env python3
"""Cliente de linha de comando do phoned.

Nao importa o pacote phoned de proposito: fala o mesmo protocolo de linha
JSON que o QML vai falar, o que mantem o contrato de IPC honesto.
"""

import argparse
import asyncio
import json
import os
import base64
import sys
import uuid
from pathlib import Path


# Espelha protocol.MAX_LINE_BYTES do phoned. Literal de proposito: este arquivo
# nao importa o pacote phoned, para o contrato de IPC continuar honesto. Sem
# passar isto para o open_unix_connection, o buffer do StreamReader seria o
# default de 64KB, e uma resposta grande do daemon, que pode escrever ate 1MiB,
# viraria LimitOverrunError cru antes de qualquer parse.
MAX_LINE_BYTES = 1024 * 1024


class RespostaGrande(Exception):
    """Linha vinda do daemon acima do limite de linha do protocolo."""


def caminho_padrao():
    base = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    return Path(base) / "phone" / "ipc.sock"


async def le_linha(reader):
    try:
        return await reader.readline()
    except ValueError as exc:
        # O StreamReader estoura ValueError quando a linha passa do buffer.
        # Com MAX_LINE_BYTES configurado acima, chegar aqui significa que o
        # daemon furou o proprio limite de linha. Traduzir evita traceback cru.
        raise RespostaGrande(str(exc)) from exc


def pacote(tipo, corpo=None):
    packet_id = str(uuid.uuid4())
    linha = json.dumps({
        "id": packet_id, "type": tipo, "ts": 0, "body": corpo or {},
    }, ensure_ascii=False) + "\n"
    return linha, packet_id


async def pergunta(caminho, tipo, corpo=None):
    reader, writer = await asyncio.open_unix_connection(
        str(caminho), limit=MAX_LINE_BYTES
    )
    try:
        linha_pedido, meu_id = pacote(tipo, corpo)
        writer.write(linha_pedido.encode("utf-8"))
        await writer.drain()
        while True:
            linha = await le_linha(reader)
            if not linha:
                raise ConnectionError("phoned fechou a conexao sem responder")
            resposta = json.loads(linha)

            # O tipo sozinho nao basta. O daemon empurra um evento pair.result
            # para todos os clientes conectados, com exatamente o mesmo nome da
            # resposta direta ao comando pair. Um pareamento alheio expirando
            # seria lido como resposta nossa. E para isso que o request_id
            # existe.
            if resposta["body"].get("request_id") == meu_id:
                return resposta

            # Erro sem correlacao so chega quando o daemon nao conseguiu sequer
            # ler o nosso pacote, e nunca vem por broadcast, entao e nosso.
            if resposta["type"] == "error" and "request_id" not in resposta["body"]:
                return resposta
    finally:
        writer.close()


async def observa(caminho):
    reader, writer = await asyncio.open_unix_connection(
        str(caminho), limit=MAX_LINE_BYTES
    )
    try:
        while True:
            linha = await le_linha(reader)
            if not linha:
                return
            evento = json.loads(linha)
            print(f"{evento['type']}: {json.dumps(evento['body'], ensure_ascii=False)}")
    finally:
        writer.close()


def imprime_lista(devices):
    if not devices:
        print("Nenhum aparelho conhecido ainda.")
        return
    largura = max(len(d["name"]) for d in devices)
    for d in devices:
        estado = "conectado" if d["connected"] else "offline"
        confianca = "pareado" if d["paired"] else "nao pareado"
        endereco = d.get("address") or "-"
        print(f"{d['name']:<{largura}}  {d['device_id']}  {estado}  {confianca}  {endereco}")


async def comando_fs(caminho, args):
    if args.acao == "ls":
        r = await pergunta(caminho, "fs.list", {"path": args.caminho})
        corpo = r["body"]
        if corpo.get("error"):
            print(f"phonectl: {corpo['error']}", file=sys.stderr)
            if corpo.get("limitado"):
                print("        abra o app no celular e toque em "
                      "'Liberar acesso aos arquivos'", file=sys.stderr)
            return 1
        print(corpo.get("path", args.caminho))
        for e in corpo.get("entries", []):
            marca = "/" if e["dir"] else " "
            tam = "" if e["dir"] else f"{e['size']:>12,}".replace(",", ".")
            print(f"  {marca} {e['name']:<44} {tam}")
        return 0

    # pull: baixa em pedacos. Um arquivo de 200 MB nao cabe num pacote, e o
    # protocolo corta a linha em 1 MiB, entao o download e um laco de leituras.
    destino = Path(args.destino) if args.destino else Path(args.caminho).name
    if destino.is_dir():
        destino = destino / Path(args.caminho).name
    offset, total = 0, None
    with open(destino, "wb") as saida:
        while True:
            r = await pergunta(caminho, "fs.read",
                               {"path": args.caminho, "offset": offset, "size": 196608})
            corpo = r["body"]
            if corpo.get("error"):
                print(f"phonectl: {corpo['error']}", file=sys.stderr)
                return 1
            total = corpo.get("total", total)
            pedaco = base64.b64decode(corpo.get("data") or "")
            saida.write(pedaco)
            offset += len(pedaco)
            if total:
                pct = offset * 100 // max(total, 1)
                print(f"\r  {offset:,} de {total:,} bytes ({pct}%)".replace(",", "."),
                      end="", file=sys.stderr)
            if corpo.get("eof") or not pedaco:
                break
    print(f"\n{destino}", file=sys.stderr)
    return 0


async def executa(args):
    caminho = Path(args.socket) if args.socket else caminho_padrao()

    if args.comando == "fs":
        return await comando_fs(caminho, args)

    if args.comando == "watch":
        await observa(caminho)
        return 0

    pedidos = {
        "list": ("list", {}),
        "pair": ("pair", {"device_id": getattr(args, "device_id", None)}),
        "confirm": ("confirm", {
            "device_id": getattr(args, "device_id", None), "accept": not args.reject,
        }),
        "unpair": ("unpair", {"device_id": getattr(args, "device_id", None)}),
        "ping": ("ping", {"device_id": getattr(args, "device_id", None)}),
        "connect": ("connect", {"host": getattr(args, "host", None), "port": args.port}),
        "reply": ("reply", {
            "key": getattr(args, "key", None),
            "text": getattr(args, "text", None),
            "device_id": getattr(args, "device_id", None),
        }),
    }
    tipo, corpo = pedidos[args.comando]
    resposta = await pergunta(caminho, tipo, corpo)

    if resposta["type"] == "error":
        print(f"phonectl: {resposta['body'].get('message')}", file=sys.stderr)
        return 1

    corpo = resposta["body"]
    match args.comando:
        case "list":
            imprime_lista(corpo["devices"])
        case "ping":
            latencia = corpo.get("latency_ms")
            if latencia is None:
                print("phonectl: sem resposta do aparelho", file=sys.stderr)
                return 1
            print(f"pong em {latencia:.1f} ms")
        case _:
            if not corpo.get("ok", False):
                print(f"phonectl: {args.comando} nao teve efeito", file=sys.stderr)
                return 1
            print("ok")
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(prog="phonectl", description="Controle do Phone Link")
    parser.add_argument("--socket", default=None, help="caminho do ipc.sock")
    sub = parser.add_subparsers(dest="comando", required=True)

    sub.add_parser("list", help="lista aparelhos conhecidos")
    sub.add_parser("watch", help="acompanha os eventos do daemon")

    for nome, ajuda in [
        ("pair", "pede pareamento"),
        ("unpair", "esquece um aparelho"),
        ("ping", "mede a latencia ate o aparelho"),
    ]:
        p = sub.add_parser(nome, help=ajuda)
        p.add_argument("device_id")

    p = sub.add_parser("confirm", help="confirma ou recusa um pareamento pendente")
    p.add_argument("device_id")
    p.add_argument("--reject", action="store_true", help="recusa em vez de aceitar")

    p = sub.add_parser("fs", help="navega e baixa arquivos do celular")
    fsub = p.add_subparsers(dest="acao", required=True)
    q = fsub.add_parser("ls", help="lista uma pasta")
    q.add_argument("caminho", nargs="?", default="/", help="padrao: raiz do armazenamento")
    q = fsub.add_parser("pull", help="baixa um arquivo")
    q.add_argument("caminho")
    q.add_argument("destino", nargs="?", default=None)

    p = sub.add_parser("reply", help="responde uma notificacao do celular")
    p.add_argument("key", help="chave da notificacao (vem no hint x-phonelink-key)")
    p.add_argument("text", help="texto da resposta")
    p.add_argument("--device-id", default=None,
                   help="so precisa com mais de um aparelho pareado")

    p = sub.add_parser("connect", help="conecta manualmente, para redes sem broadcast")
    p.add_argument("host")
    p.add_argument("--port", type=int, default=1739)

    args = parser.parse_args(argv if argv is not None else sys.argv[1:])
    if not hasattr(args, "reject"):
        args.reject = False
    if not hasattr(args, "port"):
        args.port = 1739

    try:
        return asyncio.run(executa(args))
    # ConnectionError cobre tanto a recusa do sistema quanto o caso de o daemon
    # cair no meio do pedido, que a propria pergunta levanta. Sem isso o segundo
    # apareceria como traceback cru.
    except (FileNotFoundError, ConnectionError):
        print(
            "phonectl: nao consegui falar com o phoned. Ele esta rodando? "
            "Tente: systemctl --user status phoned",
            file=sys.stderr,
        )
        return 1
    except RespostaGrande as exc:
        print(f"phonectl: resposta do phoned acima do limite de linha ({exc})",
              file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
